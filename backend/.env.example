# ===== LLM Provider =====
# Supported: openai | anthropic | deepseek | qwen
LLM_PROVIDER=openai

# ----- OpenAI -----
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ----- Anthropic (optional) -----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ----- DeepSeek (OpenAI compatible) -----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ----- Qwen DashScope (OpenAI compatible) -----
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ===== Model behavior =====
OPENAI_TEMPERATURE=0.7
MAX_TOKENS=2048
MAX_ITERATIONS=8

# ===== Memory / Persistence =====
# memory | sqlite
CHECKPOINTER=memory
SQLITE_PATH=./data/chat.db

# ===== Human-in-the-loop =====
# true = interrupt before agent node, requires /resume to continue
HITL=false

# ===== Server =====
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ===== LangSmith (optional) =====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smart-data-agent