# ===== LLM Provider =====
# Supported: openai | anthropic | deepseek | qwen
LLM_PROVIDER=openai

# ----- OpenAI -----
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ----- Anthropic (optional) -----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ----- DeepSeek (OpenAI compatible) -----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ----- Qwen DashScope (OpenAI compatible) -----
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ===== Model behavior =====
OPENAI_TEMPERATURE=0.7
MAX_TOKENS=2048
MAX_ITERATIONS=8

# ===== Review Agent (secondary LLM for cross-checking reports) =====
REVIEW_ENABLED=false
REVIEW_LLM_PROVIDER=anthropic

# ----- Review: Anthropic (default) -----
REVIEW_ANTHROPIC_API_KEY=
REVIEW_ANTHROPIC_MODEL=claude-sonnet-4-5

# ----- Review: OpenAI -----
REVIEW_OPENAI_API_KEY=
REVIEW_OPENAI_MODEL=
REVIEW_OPENAI_BASE_URL=
REVIEW_OPENAI_TEMPERATURE=0.7

# ----- Review: DeepSeek -----
REVIEW_DEEPSEEK_API_KEY=
REVIEW_DEEPSEEK_BASE_URL=https://api.deepseek.com
REVIEW_DEEPSEEK_MODEL=deepseek-chat

# ----- Review: Qwen -----
REVIEW_QWEN_API_KEY=
REVIEW_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REVIEW_QWEN_MODEL=qwen-plus

REVIEW_MAX_TOKENS=4096
REVIEW_MAX_ITERATIONS=8

# ===== Memory / Persistence =====
# memory | sqlite
CHECKPOINTER=memory
SQLITE_PATH=./data/chat.db

# ===== Human-in-the-loop =====
# true = interrupt before agent node, requires /resume to continue
HITL=false

# ===== Server =====
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ===== LangSmith (optional) =====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smart-data-agent